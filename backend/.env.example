# ---------------------------------------------------------------
# VulnShop backend configuration
# ---------------------------------------------------------------
# APP_MODE=lab        -> vulnerable labs can be toggled ON (local only)
# APP_MODE=production -> every lab is forced into SECURE mode, lab
#                        control endpoints are disabled.
# NODE_ENV=production also forces secure mode.
APP_MODE=lab
NODE_ENV=development

# Network: in lab mode the API binds to loopback only.
HOST=127.0.0.1
PORT=4000
# Only set inside Docker (container must bind 0.0.0.0; compose publishes on 127.0.0.1)
ALLOW_CONTAINER_BIND=false

# Database: mysql (default) or sqlite (quick local start, no MySQL needed)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vulnshop
DB_USER=vulnshop
DB_PASSWORD=vulnshop_lab_password
DB_STORAGE=./vulnshop.sqlite

# Strong secret used in SECURE mode (>= 32 chars). Generated at boot if empty (lab mode only).
JWT_SECRET=

# Allowed browser origins (secure CORS mode)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Extra Host header names accepted by the local-only guard (comma separated)
EXTRA_ALLOWED_HOSTS=
